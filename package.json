{
  "name": "@myzzz/agentlink",
  "version": "0.1.34",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Local control plane for connecting trusted coding agents to messaging channels.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "bin": {
    "agentlink-gateway": "dist/src/main.js",
    "agentlink": "dist/src/ctl.js",
    "agentlinkctl": "dist/src/ctl.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs unit contract",
    "test:integration": "node scripts/run-tests.mjs integration fault",
    "test:acceptance": "node scripts/run-tests.mjs acceptance",
    "test:all": "node scripts/run-tests.mjs",
    "postinstall": "node scripts/npm-postinstall.mjs",
    "prepack": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "release:macos": "node scripts/build-release.mjs",
    "release:sign-dmg": "node scripts/sign-notarize-release.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:windows": "node --test dist/test/fault/child-process-transport.test.js dist/test/unit/managed-log-sink.test.js dist/test/unit/windows-command-capture.test.js dist/test/unit/windows-foreground-ready-notice.test.js dist/test/unit/windows-platform.test.js dist/test/unit/windows-wechat-channel-reload.test.js",
    "check:windows": "npm run typecheck && npm run build && npm run check:boundaries && npm run check:secrets && npm run test:windows",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.json && node scripts/copy-assets.mjs && node scripts/check-boundaries.mjs && node scripts/check-secrets.mjs && node scripts/run-tests.mjs"
  },
  "files": [
    "dist/src/",
    "dist/migrations/",
    "dist/protocol-fixtures/",
    "scripts/npm-postinstall.mjs",
    "src/platform-macos/keychain-helper.m",
    "src/platform-macos/qr-code-renderer.m",
    "LICENSE",
    "OPERATIONS.md",
    "CONTRIBUTING.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "better-sqlite3": "12.11.1",
    "lossless-json": "^4.3.0",
    "qrcode": "1.5.4",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0",
    "koffi": "3.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}
